# Copy this file to .env and fill in the values you need. Login providers
# (Google, GitHub, Microsoft/Azure AD, or any OIDC/OAuth2 provider) are NOT
# configured here — they're added from the UI at Admin -> Login Providers
# and stored (encrypted) in the database, so any company can plug in their
# own identity provider without a redeploy. See README.md "Login & SSO"
# section for setup steps per provider.

# Random key used to sign the session cookie, AND to encrypt login
# provider client secrets at rest. Generate with:
#   openssl rand -hex 32
# Keep this stable once you start adding login providers -- changing it
# makes previously-saved client secrets permanently undecryptable (you'd
# just re-enter them in the UI).
DASHBOARD_SESSION_SECRET=

# Optional: force-enable/disable login regardless of whether any provider/
# local account is configured. Leave unset to let the app decide (login
# required as soon as >=1 provider or local account exists; open access
# until then).
# DASHBOARD_AUTH_ENABLED=true

# One-time migration only (pre-existing deployments): if these three are
# set AND no "azure-ad" login provider exists yet in the database, one is
# auto-created from them on first startup (secret encrypted), then never
# read again -- manage/rotate it from Admin -> Login Providers afterwards.
# New deployments should ignore these and just use the UI instead.
# AZURE_AD_CLIENT_ID=
# AZURE_AD_CLIENT_SECRET=
# AZURE_AD_TENANT_ID=

# Optional: comma-separated emails allowed to view every machine's data.
# Anyone signed in but NOT listed here only sees the machine(s) where
# machines.logged_in_user matches their email (see Database.get_machine_ids_for_user
# in src/database.py). Only applied once login is required (see above).
# DASHBOARD_ADMIN_EMAILS=alice@example.com,bob@example.com

# Optional: dashboard host/port (defaults shown)
# DASHBOARD_HOST=127.0.0.1
# DASHBOARD_PORT=8765

# Optional: Azure DevOps integration (links sessions to PRs/commits for
# "AI-assisted PR" stats under Admin -> Azure DevOps). Create a Personal
# Access Token with "Code (Read)" scope at <org-url>/_usersSettings/tokens.
# Leave both unset to keep the integration disabled.
# AZURE_DEVOPS_ORG_URL=https://dev.azure.com/your-org
# AZURE_DEVOPS_PAT=
