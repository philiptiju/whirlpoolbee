<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.local.claude.daily-rollup</string>

    <key>ProgramArguments</key>
    <array>
        <string>VENV_PATH/bin/python3</string>
        <string>INSTALL_PATH/scripts/daily_rollup.py</string>
    </array>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>0</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>LOG_PATH/daily-rollup.log</string>

    <key>StandardErrorPath</key>
    <string>LOG_PATH/daily-rollup.err</string>

    <key>RunAtLoad</key>
    <true/>
</dict>
</plist>
