<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.local.claude.process-metrics</string>

    <key>ProgramArguments</key>
    <array>
        <string>VENV_PATH/bin/python3</string>
        <string>INSTALL_PATH/scripts/collect_process_metrics.py</string>
    </array>

    <key>StartInterval</key>
    <integer>60</integer>

    <key>StandardOutPath</key>
    <string>LOG_PATH/process-metrics.log</string>

    <key>StandardErrorPath</key>
    <string>LOG_PATH/process-metrics.err</string>

    <key>RunAtLoad</key>
    <true/>
</dict>
</plist>
